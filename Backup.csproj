<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <StartupObject>Backup.Program</StartupObject>
    <RootNamespace>Backup</RootNamespace>
    <AssemblyName>BackupLabs</AssemblyName>
    <!-- the only place a version is written: build.ps1, the installer and the updater all read it -->
    <Version>1.0.0</Version>
    <Product>Backup Labs</Product>
    <Company>Protagonist Labs</Company>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**;dist\**" />
    <Page Remove="tests\**;dist\**" />
    <None Remove="tests\**;dist\**" />
  </ItemGroup>
</Project>
