<Window x:Class="Backup.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update" Width="540" Height="460" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="Transparent"
        Foreground="#E8EEF6" FontFamily="Segoe UI" FontSize="14">
  <Grid Background="#B30A0D13">
    <DockPanel Margin="24,20,24,20">
      <TextBlock x:Name="Heading" DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock x:Name="Sub" DockPanel.Dock="Top" Foreground="{StaticResource Dim}" Margin="0,4,0,16"/>

      <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="LaterButton" Content="Later" Margin="0,0,10,0" Click="Later_Click"/>
          <Button x:Name="UpdateButton" Style="{StaticResource Primary}" Content="Update now" Click="Update_Click"/>
        </StackPanel>
        <TextBlock x:Name="Status" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,12,0"
                   TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular"/>
      </DockPanel>
      <ProgressBar x:Name="DownloadBar" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,14,0,0" AutomationProperties.Name="Download progress"/>

      <Border Background="#59000000" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="12" Padding="4">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="Notes" Foreground="#D6DEEA" FontSize="13.5" Margin="12,10" TextWrapping="Wrap"/>
        </ScrollViewer>
      </Border>
    </DockPanel>
  </Grid>
</Window>
